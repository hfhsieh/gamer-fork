# problem-specific runtime parameters
PSC_Mass              1.0            # mass   of the spherical molecular cloud, in solar mass [1.0]
PSC_Radius            5.0e3          # radius of the spherical molecular cloud, in AU [5.0e3]
PSC_Ratio_Dens_Edge   1.0e1          # ratio of central to edge    density [1.0e1]
PSC_Ratio_Dens_Env    1.0e2          # ratio of edge to background density [1.0e2]
PSC_Ratio_Energy      1.0e-2         # ratio of rotational to gravitational energy [1.0e-2]

# profile
PSC_Prof              0              # output spherically averaged profile at each global step [0]
PSC_Prof_LogBin       0              # log/linear bins [0]
                                     # (true=logarithmic, false=linear)
PSC_Prof_LogBinRatio  1.01           # ratio of adjacent log bins [1.01]
PSC_Prof_MaxRadius   -1.0            # maximum radius in the radial profile, in code units [-1.0]
                                     # (<=0=sqrt(3) * amr->BoxSize)
PSC_Prof_MinBinSize  -1.0            # minimum bin size, in code units [-1.0]
                                     # (<=0=use amr->dh[MAX_LEVEL])
