# problem-specific runtime parameters
CCSN_Prob                     1                  # target CCSN problem
                                                 #    0 : Migration Test (GREP)
                                                 #    1 : CCSN
CCSN_Prof_File                IC/s20_W2007       # filename of input profile
CCSN_Opt_InitEint             1                  # Mode of obtaining internal energy in SetGridIC() [1]
                                                 # ( 1=Temp Mode: Eint(dens, temp, [Ye])
                                                 #   2=Pres Mode: Eint(dens, pres, [Ye]) )
CCSN_Is_PostBounce            0                  # boolean that indicates whether core bounce has occurred [0]
                                                 # (determined from CCSN_BounceTime and automatically updated in restart runs)


# magnetic field configuration
CCSN_Mag                      1                  # target magnetic field profile [1]
                                                 # ( 0: A_r     = 0
                                                 #      A_phi   = B0* varpi^2 * (1 - rho / rho_max)^np * (P / P_max)
                                                 #      A_theta = 0
                                                 #   1: A_r     = 0
                                                 #      A_phi   = 0.5 * B0 * ( R0^3 / (r^3 + R0^3) ) * r * sin(theta)
                                                 #      A_theta = 0
                                                 #   2: A_r     = 0.5 * B0 * ( R0^3 / (r^3 + R0^3) ) * r * cos(theta)
                                                 #      A_phi   = 0.5 * B0 * ( R0^3 / (r^3 + R0^3) ) * r * sin(theta)
                                                 #      A_theta = 0                                                   )
CCSN_Mag_B0                   1.0e10             # magnetic field strength, in gauss [1.0e10]
CCSN_Mag_np                   0.0                # dependence of magnetic field on density [0.0]
CCSN_Mag_R0                   1.0e8              # characteristic radius of magnetic field, in cm [1.0e8]


# rotation profile
CCSN_Rot                      0                  # mode for rotational profile (0:off, 1:analytical, 2:table) [0]
                                                 # --> analytical formula: Omega(r) = Omega_0 * [ R_0^2 / (r^2 + R_0^2) ],
                                                 #     where r is the spherical radius
CCSN_Rot_R0                   1.0e8              # characteristic radius R_0 in the analytical formula, in cm [2.0e8]
CCSN_Rot_Omega0               0.0                # central angular frequency Omega_0 in the analytical formula, in rad/s [0.5]
CCSN_Rot_Fac                 -1.0                # multiplication factor for the tabular rotational profile (<=0=off) [-1.0]


# grid refinement
CCSN_Ref_CC_Flag1             1                  # flag for enabling maximum refinement level limit 1 in the collapse phase [0]
CCSN_Ref_CC_Flag2             1                  # flag for enabling maximum refinement level limit 2 in the collapse phase [0]
CCSN_Ref_CC_MaxLv1           -1                  # maximum refinement level when central density is below CCSN_Ref_CC_Dens1
                                                 # (<0=MAX_LEVEL-2) [-1]
CCSN_Ref_CC_MaxLv2           -1                  # maximum refinement level when central density is below CCSN_Ref_CC_Dens2
                                                 # (<0=MAX_LEVEL-1) [-1]
CCSN_Ref_CC_Dens1             1.0e11             # central density threshold for refinement level limit 1, in g/cm3 [1.0e11]
CCSN_Ref_CC_Dens2             1.0e12             # central density threshold for refinement level limit 2, in g/cm3 [1.0e12]
CCSN_Ref_MaxLv_Rad            3.0e6              # radius within which maximum refinement is enforced, in cm [3.0e6]
CCSN_Ref_BaseRad             -1.0                # characteristic radius for limiting maximum refinement level, in cm
                                                 # (<=0=off) [-1.0]
CCSN_Ref_AngRes_Min          -1.0                # minimum angular resolution, in degrees (<=0=off) [-1.0]
CCSN_Ref_AngRes_Max          -1.0                # maximum angular resolution, in degrees (<=0=off) [-1.0]
CCSN_Ref_Shock_AngResMax     -1.0                # maximum angular resolution for the shock-radius-based criterion, in degrees (<=0=off) [-1.0]
CCSN_Ref_Shock_Rsh            1.5e7              # average shock radius threshold for activating the shock-radius-based criterion, in cm [1.5e7]
CCSN_Ref_Shock_Rad            1.5e7              # minimum radius for applying the shock-radius-based criterion, in cm [1.5e7]


# time-step
CCSN_Dt_CC_Thres_Dens         1.0e13             # central density threshold for reducing the time step in the collapse phase, in g/cm3 [1.0e13]
CCSN_Dt_CC_TimeStep           1.0e-5             # reduced time step when the central density exceeds CCSN_Dt_CC_Thres_Dens, in s [1e-5]
CCSN_Dt_PB_NuHeat_Fac         0.01               # factor that scales the time step constrained by the neutrino scheme [0.01]
CCSN_Dt_PB_NuHeat_YeMode      1                  # dt criterion on Ye for the neutrino scheme (1=Ye-Ye_min/Ye_max, 2=Ye, 3=none) [1]


# data dump
CCSN_Output_GW                1                  # output GW signals (0=off, 1=on) [0]
CCSN_Output_GW_Dt             0.1                # output GW signals every CCSN_Output_GW_Dt time interval [1.0]
CCSN_Output_PB_Dt            -1.0                # output data every CCSN_Output_PB_Dt time interval during the postbounce phase [-1.0]


# miscellaneous
CCSN_Shock_ThresFac_Pres      0.5                # pressure threshold factor for detecting postbounce shock [0.5]
CCSN_Shock_ThresFac_Vel       0.1                # velocity threshold factor for detecting postbounce shock [0.1]
CCSN_Shock_Weight             2                  # weighting of each cell when calculating the average shock radius [2]
                                                 # (1:Volume, 2:1/Volume)
